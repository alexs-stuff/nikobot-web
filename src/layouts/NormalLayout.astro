---
import { ClientRouter } from "astro:transitions";
import NavbarHolder from "../components/ui/navbar/NavbarHolder.astro";
import "../styles/global.css";

const { class: className } = Astro.props as { class: string };
import { twMerge } from "tailwind-merge";
---

<!doctype html>
<html lang="en">
    <head>
        <ClientRouter />
        <style is:global>
            ::view-transition-old(root),
            ::view-transition-new(root) {
                animation: none;
            }
        </style>
        <meta charset="utf-8" />
        <link rel="icon" href="/niko_favicon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://cdn.alex427.com/fonts/terminus.css"
            rel="stylesheet"
        />
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/@twemoji/api@latest/dist/twemoji.min.js"
            crossorigin="anonymous"></script>

        <meta property="og:title" content="NikoBot" />
        <meta property="og:image" content="/niko.png" />

        <title>NikoBot</title>
    </head>
    <body
        class="font-inter h-auto min-h-dvh w-full overflow-x-hidden bg-black to-40%">
        {/*  bg-radial-[at_50%_0%] from-primary-bg from-0% to-[#14031d] */}
        <NavbarHolder />
        <div class="flex h-auto min-h-dvh flex-col items-center justify-center">
            <main
                class={`${twMerge("min-h-dvh h-auto w-full overflow-x-hidden p-4 pt-24 text-white flex max-w-[70%] flex-col items-center justify-start  ", className)}`}>
                <slot />
            </main>
        </div>

        <footer
            class="flex h-16 w-full flex-col items-center justify-center bg-white text-center text-[14px] text-black">
            <span
                >Copyright &copy; <strong>Alex's Stuff</strong> 2025-{
                    new Date().getFullYear()
                }</span
            >
            <span
                >NikoBot &amp; Alex's Stuff is <strong>NOT</strong> affiliated with
                Future Cat Games LLC
            </span>
        </footer>
    </body>
</html>
